---
import { features, filterGroups, groups } from '../lib/tools';

interface Props { total: number }
const { total } = Astro.props;
---
<div class="filter-bar" id="filter-bar">
  <label class="min-w-44 flex-1">
    <span class="sr-only">Search tools by name</span>
    <input class="field w-full" type="search" data-filter="name" placeholder={`Search ${total} tools`} />
  </label>
  {filterGroups.map((group) => (
    <details class="filter-menu" data-group={group.id}>
      <summary>{group.label}<span class="filter-count" hidden></span></summary>
      <div class="filter-pop">
        {group.options.map(([value, label]) => <label><input type="checkbox" data-filter="option" value={value} />{label}</label>)}
      </div>
    </details>
  ))}
  <details class="filter-menu" data-features>
    <summary>Has feature<span class="filter-count" hidden></span></summary>
    <div class="filter-pop max-h-80 overflow-y-auto md:right-0 md:left-auto md:w-72">
      <label class="border-line mb-1 border-b font-semibold"><input type="checkbox" data-filter="free" />Only without paying</label>
      {groups.map((group) => (
        <>
          <p class="filter-heading">{group.name}</p>
          {features.filter((feature) => feature.group === group.id).map((feature) => <label><input type="checkbox" data-filter="option" value={feature.id} />{feature.name}</label>)}
        </>
      ))}
    </div>
  </details>
  <slot name="menus" />
</div>
<div class="mt-2 flex min-h-8 flex-wrap items-center gap-x-4 gap-y-2">
  <slot name="status" />
  <div class="flex flex-wrap gap-1.5" id="filter-tokens"></div>
  <button class="text-button" id="filter-clear" type="button" hidden>Clear filters</button>
</div>
<p class="text-muted mt-2" id="filter-empty" hidden>No tool matches all of these. Remove a filter to see more.</p>
