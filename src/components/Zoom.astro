<dialog id="zoom" class="zoom" aria-labelledby="zoom-title">
  <div class="flex items-start justify-between gap-4">
    <h2 id="zoom-title" class="text-2xl"></h2>
    <form method="dialog"><button class="button">Close</button></form>
  </div>
  <img id="zoom-image" class="mx-auto mt-3 max-h-[72vh] w-full object-contain" alt="" />
  <p id="zoom-caption" class="text-muted mt-3"></p>
  <p class="mt-1 flex flex-wrap gap-x-5"><a id="zoom-page">Open the full page</a><a id="zoom-manual">Manual</a></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#zoom');
  const title = document.querySelector('#zoom-title');
  const image = document.querySelector<HTMLImageElement>('#zoom-image');
  const caption = document.querySelector('#zoom-caption');
  const page = document.querySelector<HTMLAnchorElement>('#zoom-page');
  const manual = document.querySelector<HTMLAnchorElement>('#zoom-manual');

  // Triggers sit on or inside real links, so a new tab or a page without scripts still reaches the page.
  document.addEventListener('click', (event) => {
    const trigger = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-zoom]') : null;
    if (!trigger || !dialog || !image || !page || !manual || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const { zoom, zoomTitle, zoomCaption, zoomManual } = trigger.dataset;
    image.src = zoom ?? '';
    image.alt = zoomTitle ?? '';
    if (title) title.textContent = zoomTitle ?? '';
    if (caption) caption.textContent = zoomCaption ?? '';
    page.href = trigger.closest('a')?.href ?? '';
    manual.hidden = !zoomManual;
    manual.href = zoomManual ?? '';
    dialog.showModal();
  });
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>
