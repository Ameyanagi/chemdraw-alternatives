---
import Layout from '../../layouts/Layout.astro';
import Legend from '../../components/Legend.astro';
import Mark from '../../components/Mark.astro';
import { href } from '../../lib/paths';
import { featureOf, features, loadTools, proofOf, shotZoom, testedVersion } from '../../lib/tools';

export async function getStaticPaths() {
  return features.map((feature) => ({ params: { id: feature.id }, props: { feature } }));
}

const { feature } = Astro.props as { feature: (typeof features)[number] };
const entries = (await loadTools())
  .filter((tool) => tool.tier !== 'related')
  .map((tool) => ({ tool, value: featureOf(tool, feature.id) }));
const has = entries.filter(({ value }) => ['yes', 'partial'].includes(value.status));
const pictured = has.filter(({ value }) => value.shot);
const listed = has.filter(({ value }) => !value.shot);
const missing = entries.filter(({ value }) => value.status === 'no');
const unknown = entries.filter(({ value }) => value.status === 'unknown');
const powered = new Map<string, number>();
for (const { value } of has) if (value.engine) powered.set(value.engine.library, (powered.get(value.engine.library) ?? 0) + 1);
const lists = [
  { title: 'Available, no screenshot', items: listed },
  { title: 'Not available', items: missing },
];
---
<Layout title={feature.name} description={feature.test}>
  <section class="page py-10">
    <p><a href={href('compare/')}>All features</a></p>
    <h1 class="mt-2 text-5xl">{feature.name}</h1>
    <p class="lede mt-3">{feature.test}</p>
    <p class="text-muted mt-3">{has.length} tools have this, {pictured.length} of them shown here. {missing.length} do not. {unknown.length} not established.</p>
    {powered.size > 0 && (
      <p class="mt-3"><span class="font-semibold">What powers it:</span> {[...powered].sort((a, b) => b[1] - a[1]).map(([library, count]) => `${library} (${count})`).join(', ')}</p>
    )}
    <div class="mt-4"><Legend /></div>
  </section>

  {pictured.length > 0 && (
    <section class="page mb-14">
      <div class="wall">
        {pictured.map(({ tool, value }) => (
          <a class="bg-paper hover:bg-silica flex flex-col p-3 no-underline" href={href(`shots/${tool.slug}/${feature.id}/`)} {...shotZoom(tool, feature.id)}>
            <div class="aspect-[4/3] overflow-hidden"><img class="size-full object-contain" src={href(value.shot!.image)} loading="lazy" decoding="async" alt={value.shot!.caption} /></div>
            <p class="mt-2 flex items-center gap-1.5 font-semibold"><Mark feature={value} /> {tool.name}</p>
            <p class="text-muted text-[0.9rem]">{testedVersion(tool)}</p>
            {value.engine && <p class="text-[0.9rem]">Uses {value.engine.library}</p>}
            {value.status === 'partial' && <p class="text-[0.9rem]">Partly: {value.note}</p>}
            <p class="text-muted text-[0.9rem]">{value.shot!.caption}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {lists.filter((list) => list.items.length > 0).map((list) => (
    <section class="page mb-14">
      <h2 class="text-3xl">{list.title}</h2>
      {list.items.some(({ tool }) => tool.id === 'p01') && <p class="text-muted mt-1">ChemDraw's license keeps us from publishing pictures of its interface.</p>}
      <ul class="mt-3 max-w-4xl">
        {list.items.map(({ tool, value }) => (
          <li class="border-line grid grid-cols-[1.5rem_1fr] gap-x-1 border-b py-1.5 md:grid-cols-[1.5rem_18rem_1fr]">
            <span><Mark feature={value} proof={proofOf(tool, feature.id)} /></span>
            <a href={href(`tools/${tool.slug}/`)}>{tool.name}</a>
            <span class="text-muted col-start-2 text-[0.95rem] md:col-start-3">
              {value.engine && <span class="text-ink">Uses {value.engine.library}. </span>}
              {value.note}
              {value.source?.startsWith('http') && <a class="ml-1" href={value.source}>Source</a>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {unknown.length > 0 && (
    <section class="page mb-14">
      <details>
        <summary class="cursor-pointer font-semibold">Not established ({unknown.length})</summary>
        <p class="mt-3 max-w-[66ch]">{unknown.map(({ tool }, index) => <>{index > 0 && ', '}<a href={href(`tools/${tool.slug}/`)}>{tool.name}</a></>)}</p>
      </details>
    </section>
  )}
</Layout>
