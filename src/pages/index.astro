---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import Specimen from '../components/Specimen.astro';
import ToolRow from '../components/ToolRow.astro';
import { href } from '../lib/paths';
import { isTested, loadTools, molecules, testedVersion } from '../lib/tools';
import watchlist from '../data/watchlist.json';

const tools = await loadTools();
const drawingTools = tools.filter((tool) => tool.tier === 'alternative');
const embeddable = tools.filter((tool) => tool.tier === 'embeddable');
const related = tools.filter((tool) => tool.tier === 'related');
const tested = tools.filter(isTested);
const wall = [...drawingTools, ...embeddable].filter((tool, index) => index < 2 || isTested(tool)).slice(0, 16);
---
<Layout>
  <section class="page pt-10 pb-6 md:pt-14">
    <h1 class="max-w-[17ch] text-5xl md:text-7xl">The same molecule, drawn by every ChemDraw alternative</h1>
    <p class="lede mt-5">We ran {tested.length} tools, gave each one the same three molecules, and kept each tool's default settings. ChemDraw is the one exception, shown in its ACS Document 1996 style.</p>
    <fieldset class="mt-7 flex flex-wrap gap-2" id="molecule-picker">
      <legend class="sr-only">Choose a molecule</legend>
      {molecules.map((molecule) => (
        <label class="chip"><input type="radio" name="molecule" value={molecule.id} checked={molecule.id === 'complex'} />{molecule.label}</label>
      ))}
    </fieldset>
    <p class="text-muted mt-2 text-[0.95rem]" id="molecule-detail">{molecules[1].detail}</p>
  </section>

  <section class="page" aria-label="Drawings by tool">
    <div class="wall" id="wall">
      {wall.map((tool, index) => (
        <a class="bg-paper hover:bg-silica flex flex-col p-3 no-underline" href={href(`tools/${tool.slug}/`)}>
          {molecules.map((molecule) => (
            <div class="aspect-[4/3]" data-fixture={molecule.id} hidden={molecule.id !== 'complex'}>
              <Specimen tool={tool} fixture={molecule.id} index={index} zoom />
            </div>
          ))}
          <p class="mt-2 flex items-baseline justify-between gap-3">
            <span class="font-semibold">{tool.name}</span>
            <span class="text-muted truncate text-[0.9rem]">{testedVersion(tool)}</span>
          </p>
        </a>
      ))}
    </div>
    <p class="mt-3"><a href={href('drawings/')}>See every drawing</a></p>
  </section>

  <section class="page mt-20" id="find">
    <h2 class="text-4xl">Find the tool for your work</h2>
    <p class="lede mt-3">Pick what you need. ChemDraw is listed first as the baseline, and ReShiki second because this site's maintainer wrote it. The rest follow by what we tested by hand.</p>
    <div class="mt-6">
      <FilterBar total={drawingTools.length + embeddable.length}>
        <p slot="status" class="font-semibold" id="filter-count">{drawingTools.length + embeddable.length} tools</p>
      </FilterBar>
    </div>

    <h3 class="mt-8 text-2xl" data-list-heading>Drawing applications</h3>
    <p class="text-muted">Make a publication figure from start to finish.</p>
    <ul class="mt-2" data-tool-list>{drawingTools.map((tool) => <ToolRow tool={tool} />)}</ul>
    <button class="button mt-4" type="button" data-show-all hidden>Show all {drawingTools.length} applications</button>

    <h3 class="mt-12 text-2xl" data-list-heading>Editors you embed</h3>
    <p class="text-muted">Structure editors built to live inside another web page or app.</p>
    <ul class="mt-2" data-tool-list>{embeddable.map((tool) => <ToolRow tool={tool} />)}</ul>
    <button class="button mt-4" type="button" data-show-all hidden>Show all {embeddable.length} embeddable editors</button>
  </section>

  <section class="page mt-20 grid gap-10 md:grid-cols-2" id="not-listed">
    <div>
      <h2 class="text-4xl">Why Avogadro is not here</h2>
      <p class="mt-3">Avogadro is a good 3D molecular editor, but it does not make publication-grade 2D drawings, which is ChemDraw's job. These {related.length} useful tools are left out of the comparison for the same kind of reason.</p>
      <details class="mt-6">
        <summary class="cursor-pointer font-semibold">{watchlist.length} more utilities we found</summary>
        <ul class="mt-2 text-[0.95rem]">
          {watchlist.map((item) => <li class="border-line border-b py-2"><a class="font-semibold" href={item.url}>{item.name}</a><span class="text-muted block">{item.summary}</span></li>)}
        </ul>
      </details>
    </div>
    <ul class="text-[0.95rem]">
      {related.map((tool) => <li class="border-line border-b py-2"><a class="font-semibold" href={tool.website ?? tool.repo ?? href()}>{tool.name}</a><span class="text-muted block">{tool.tierReason}</span></li>)}
    </ul>
  </section>

  <section class="page mt-20">
    <div class="bg-silica px-6 py-8 md:px-10">
      <h2 class="text-3xl">Know a tool we missed?</h2>
      <p class="mt-2 max-w-[60ch]">Send us its website or GitHub link. We test it the same way as everything else.</p>
      <p class="mt-4"><a class="button" href={href('add/')}>Add a tool</a></p>
    </div>
  </section>
</Layout>

<script>
  import { isFiltering, matches, wireFilterBar, type FilterState } from '../lib/filters';

  import { molecules } from '../lib/molecules';

  const wall = document.querySelector<HTMLElement>('#wall');
  const detail = document.querySelector<HTMLElement>('#molecule-detail');
  document.querySelector('#molecule-picker')?.addEventListener('change', (event) => {
    const selected = (event.target as HTMLInputElement).value;
    wall?.querySelectorAll<HTMLElement>('[data-fixture]').forEach((panel) => { panel.hidden = panel.dataset.fixture !== selected; });
    if (detail) detail.textContent = molecules[selected] ?? '';
  });

  const COLLAPSED_ROWS = 10;
  const lists = [...document.querySelectorAll<HTMLElement>('[data-tool-list]')];
  const count = document.querySelector<HTMLElement>('#filter-count');
  const empty = document.querySelector<HTMLElement>('#filter-empty');
  const expanded = new Set<HTMLElement>();
  let current: FilterState = { groups: [], name: '', features: [], freeOnly: false };

  function applyFilters() {
    let total = 0;
    for (const list of lists) {
      const button = list.nextElementSibling as HTMLElement;
      const rows = [...list.querySelectorAll<HTMLElement>('[data-tags]')];
      const matching = rows.filter((row) => matches(current, row));
      const showEverything = isFiltering(current) || expanded.has(list);
      for (const row of rows) {
        row.hidden = !matching.includes(row) || (!showEverything && matching.indexOf(row) >= COLLAPSED_ROWS);
      }
      button.hidden = showEverything || matching.length <= COLLAPSED_ROWS;
      total += matching.length;
    }
    if (count) count.textContent = `${total} ${total === 1 ? 'tool' : 'tools'}`;
    if (empty) empty.hidden = total > 0;
  }

  const bar = document.querySelector<HTMLElement>('#filter-bar');
  if (bar) wireFilterBar(bar, (state) => { current = state; applyFilters(); });
  for (const list of lists) {
    list.nextElementSibling?.addEventListener('click', () => { expanded.add(list); applyFilters(); });
  }
  applyFilters();
</script>
