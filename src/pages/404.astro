---
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/paths';
---
<Layout title="Page not found">
  <section class="page py-16">
    <h1 class="text-4xl">This page does not exist</h1>
    <p class="lede mt-4">It may have moved when the site was rebuilt. The full tool list is on the home page.</p>
    <p class="mt-6"><a class="button" href={href()}>Go to the home page</a></p>
  </section>
</Layout>
