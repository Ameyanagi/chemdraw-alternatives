---
import Zoom from '../components/Zoom.astro';
import '../styles/global.css';
import { href } from '../lib/paths';

interface Props { title?: string; description?: string }
const {
  title,
  description = 'A hands-on comparison of ChemDraw alternatives: the same molecules drawn by every tool, plus features, engines, sizes and APIs with exact versions.',
} = Astro.props;
const siteName = 'Chemical Drawing Atlas';
const fullTitle = title ? `${title}: ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['Drawings', 'drawings/'],
  ['Compare features', 'compare/'],
  ['Under the hood', 'under-the-hood/'],
  ['How we test', 'how-we-test/'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191f1c" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="bg-ink text-paper sr-only rounded px-3 py-2 focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50" href="#main">Skip to content</a>
    <header class="border-line border-b">
      <div class="page flex flex-wrap items-center gap-x-8 gap-y-2 py-3">
        <a class="font-bold no-underline" href={href()}>{siteName}</a>
        <nav aria-label="Main" class="flex flex-wrap gap-x-5 gap-y-1">
          {nav.map(([label, path]) => {
            const target = href(path);
            return <a class="no-underline" href={target} aria-current={Astro.url.pathname === target ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
        <div class="ml-auto flex items-center gap-1">
          <a class="icon-button" href="https://github.com/Ameyanagi/chemdraw-alternatives" aria-label="Source on GitHub" title="Source on GitHub">
            <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
          </a>
          <button class="icon-button" id="theme-toggle" type="button" aria-label="Switch between light and dark mode" title="Switch between light and dark mode">
            <svg class="theme-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="theme-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="button ml-2 py-1.5 text-[0.95rem]" href={href('add/')}>Add a tool</a>
        </div>
      </div>
    </header>
    <main id="main" class="flex-1 overflow-x-clip">
      <div class="page pt-5">
        <p class="notice">This website is biased toward ReShiki, because its maintainer also maintains <a href="https://reshiki.com/">ReShiki</a>. Please be careful.</p>
      </div>
      <slot />
    </main>
    <footer class="border-line text-muted mt-20 border-t py-8 text-[0.95rem]">
      <div class="page flex flex-wrap justify-between gap-x-10 gap-y-2">
        <p class="max-w-[60ch]">Maintained by the author of ReShiki, one of the tools listed. ChemDraw is a trademark of Revvity Signals Software. This site has no vendor endorsement.</p>
        <p><a href="https://github.com/Ameyanagi/chemdraw-alternatives">Source on GitHub</a>, <a href={href('data/tools.json')}>all data as JSON</a></p>
      </div>
    </footer>
    <Zoom />
    <script>
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
