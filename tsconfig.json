{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "evidence/downloads",
    "evidence/raw"
  ],
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [
        ".astro"
      ]
    }
  ]
}
